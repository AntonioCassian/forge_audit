    },
    {
      "id": "eb136bb67f93",
      "type": "text",
      "x": 785,
      "y": 1260,
      "width": 640,
      "height": 600,
      "angle": 0,
      "strokeColor": "#581c87",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "version": 3,
      "versionNonce": 2079594828,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794067642648,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "COLEÇÃO: audit_logs\nCada documento registra uma ação e é somente inserido.\n\nMETADADOS\n• id_log\n• id_usuario (referência lógica ao Postgres)\n• nome_usuario (snapshot no momento da ação)\n• cargo (snapshot no momento da ação)\n• ip_origem\n• data_hora (timestamp com milissegundos)\n• acao_executada\n  Ex.: ALTERACAO_STATUS_ORDEM_PRODUCAO\n\nDADOS DA ALTERAÇÃO\n• entidade_afetada (ordem_producao | equipamento)\n• id_registro_afetado\n• dados_anteriores (JSON)\n• dados_novos (JSON)\n\nEXEMPLO DE PAYLOAD\nAntes: { status_op: \"Em Execução\",\n         quantidade_produzida: 500 }\n\nDepois: { status_op: \"Suspensa\",\n          quantidade_produzida: 520,\n          motivo: \"Queda de energia na linha 2\" }\n\nREGRA DE AUDITORIA\n• Somente INSERT: sem UPDATE ou DELETE.\n• Índices por id_registro_afetado e data_hora.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COLEÇÃO: audit_logs\nCada documento registra uma ação e é somente inserido.\n\nMETADADOS\n• id_log\n• id_usuario (referência lógica ao Postgres)\n• nome_usuario (snapshot no momento da ação)\n• cargo (snapshot no momento da ação)\n• ip_origem\n• data_hora (timestamp com milissegundos)\n• acao_executada\n  Ex.: ALTERACAO_STATUS_ORDEM_PRODUCAO\n\nDADOS DA ALTERAÇÃO\n• entidade_afetada (ordem_producao | equipamento)\n• id_registro_afetado\n• dados_anteriores (JSON)\n• dados_novos (JSON)\n\nEXEMPLO DE PAYLOAD\nAntes: { status_op: \"Em Execução\",\n         quantidade_produzida: 500 }\n\nDepois: { status_op: \"Suspensa\",\n          quantidade_produzida: 520,\n          motivo: \"Queda de energia na linha 2\" }\n\nREGRA DE AUDITORIA\n• Somente INSERT: sem UPDATE ou DELETE.\n• Índices por id_registro_afetado e data_hora.",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "aZ"
    },
